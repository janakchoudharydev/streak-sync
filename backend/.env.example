# Port for local development
PORT=3000

# Secret used to sign authentication JWT tokens
JWT_SECRET=replace_with_your_own_super_secret_jwt_key_at_least_32_chars

# Optional PostgreSQL / Supabase connection string for production
# If omitted, defaults to high-speed in-memory database for local testing
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
